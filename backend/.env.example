# Supabase PostgreSQL - both lines required
DATABASE_URL=postgresql://postgres.YOURPROJECT:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.YOURPROJECT:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# --- Single sign-on with Raise Academy ---
# MUST be the exact same value as JWT_SECRET in the Raise Academy backend's .env.
# This is what lets YNeet trust a token it never issued, with no separate YNeet login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-random-string
JWT_REFRESH_SECRET=change-this-to-another-random-string
# Raise Academy backend's API base (no trailing slash), e.g. https://api.raiseacademy.com/api
RAISE_ACADEMY_API_URL=http://localhost:5000/api
# Raise Academy's frontend origin, for CORS
RAISE_ACADEMY_FRONTEND_URL=http://localhost:5173
# Shared secret for the server-to-server subscription-status callback to Raise Academy.
# MUST match INTERNAL_SERVICE_KEY in the Raise Academy backend's .env.
INTERNAL_SERVICE_KEY=change-this-too-random-string

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Anthropic (for AI Mentor)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=YNeet <yourgmail@gmail.com>

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
