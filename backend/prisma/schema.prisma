generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  // NOTE: id is NOT auto-generated. It is set to the Raise Academy (Mongo) student's
  // _id string at provisioning time, so a YNeet user always maps 1:1 to a Raise Academy
  // student — there is no separate YNeet signup/login anymore (see auth bridge).
  id            String    @id
  email         String    @unique
  name          String
  phone         String?
  gender        String?
  place         String?
  neetDate      String?
  isVerified    Boolean   @default(true)
  // Synced from Raise Academy's Student.role on every SSO login — "student" | "admin".
  // Determines access to the /admin content-management panel.
  role          String    @default("student")
  // A short unique code this user can share — see Referral model below.
  referralCode  String?   @unique
  // Legacy: UPI ID from the old cash referral reward. No longer used, but the
  // column still holds data in production, so it stays in the schema to stop
  // `prisma db push` from dropping it.
  upiId         String?
  referralsMade Referral[] @relation("ReferralsMade")
  referredBy    Referral?  @relation("ReferredUser")
  // Copy of the JWT's `sid` claim from the last time this device's token was used
  // here — see middleware/auth.js. Lets YNeet also enforce single-active-session,
  // in step with Raise Academy, without a network round-trip on every request.
  sessionId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  attempts      Attempt[]
  mistakes      Mistake[]
  streak        Streak?
  subscription  Subscription?
  xp            XP?
  userBadges    UserBadge[]
  practiceStats PracticeStat[]
  quizResults   QuizResult[]
  quizItems     QuizItem[]
  studyPlan     StudyPlan?
  shortViews    ShortView[]
  @@map("users")
}
model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Allowed values: "6th","7th","8th","9th","10th","11th","12th","Dropper"
  class            String   @default("12th")
  targetScore      Int      @default(650)
  currentScore     Int      @default(0)
  examYear         Int      @default(2026)
  neetDate         String?
  studyHoursPerDay Float    @default(6)
  weakSubjects     String[]
  strongSubjects   String[]
  phone            String?
  gender           String?
  place            String?
  // Optional — if set, a weekly progress digest email goes here (score,
  // streak, weak areas). Set by the student themselves in their Profile.
  parentEmail      String?
  lastParentDigestSent DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("profiles")
}
model MockTest {
  id          String     @id @default(cuid())
  title       String
  type        String
  classLevel  String     @default("12th")
  subject     String?
  totalMarks  Int        @default(720)
  totalQs     Int        @default(200)
  durationMin Int        @default(200)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  // Many-to-many: the same question can belong to several mock tests at once —
  // this used to be a single mockTestId FK, which meant assigning a question to
  // a new test silently unassigned it from every other test it was in.
  questions   Question[]
  attempts    Attempt[]
  @@map("mock_tests")
}
model Question {
  id            String            @id @default(cuid())
  mockTests     MockTest[]
  subject       String
  // "6th".."12th" or "Dropper" — content is scoped strictly to this class's syllabus
  classLevel    String            @default("12th")
  chapter       String
  topic         String
  difficulty    String            @default("medium")
  questionText  String            @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOpt    Int
  explanation   String            @db.Text
  isPYQ         Boolean           @default(false)
  isRepeated    Boolean           @default(false)
  pyqYear       Int?
  createdAt     DateTime          @default(now())
  responses     AttemptResponse[]
  mistakes      Mistake[]
  practiceStats PracticeStat[]
  quizItems     QuizItem[]
  // Quick-check MCQs shown after a YNeet Short (see Short model).
  shorts        Short[]
  @@map("questions")
}
model Attempt {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId   String
  mockTest     MockTest          @relation(fields: [mockTestId], references: [id])
  status       String            @default("in_progress")
  score        Int               @default(0)
  totalMarks   Int               @default(720)
  accuracy     Float             @default(0)
  timeTaken    Int               @default(0)
  physicsScore Int               @default(0)
  chemScore    Int               @default(0)
  bioScore     Int               @default(0)
  startedAt    DateTime          @default(now())
  submittedAt  DateTime?
  responses    AttemptResponse[]
  @@map("attempts")
}
model AttemptResponse {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  selected   Int?
  isCorrect  Boolean  @default(false)
  isMarked   Boolean  @default(false)
  timeSec    Int      @default(0)
  @@unique([attemptId, questionId])
  @@map("attempt_responses")
}
model Mistake {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  source     String   @default("mock")
  count      Int      @default(1)
  lastSeen   DateTime @default(now())
  @@unique([userId, questionId, source])
  @@map("mistakes")
}
model PracticeStat {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  solved     Boolean  @default(true)
  correct    Boolean  @default(false)
  solvedAt   DateTime @default(now())
  @@unique([userId, questionId])
  @@map("practice_stats")
}
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  score     Int
  total     Int
  createdAt DateTime @default(now())
  @@map("quiz_results")
}
model QuizItem {
  id         String   @id @default(cuid())
  quizDate   String
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  @@unique([quizDate, questionId])
  @@map("quiz_items")
}
model StudyPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Json
  updatedAt DateTime @updatedAt
  @@map("study_plans")
}
model Streak {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current    Int      @default(0)
  longest    Int      @default(0)
  lastActive DateTime @default(now())
  @@map("streaks")
}
model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NONE (never paid) | TRIAL_5D | MONTHLY
  plan              String    @default("NONE")
  // inactive | active | expired
  status            String    @default("inactive")
  startDate         DateTime?
  endDate           DateTime?
  amount            Int? // in paise
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  // Set true once the "your plan expires soon" email has gone out for the
  // CURRENT endDate, so the daily check doesn't email the same person twice.
  // Reset to false whenever endDate changes (renewal, admin edit, etc.).
  expiryReminderSent Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@map("subscriptions")
}

// Tracks one referral: referrer shared their code, referred person registered
// using it. `qualified` flips true once the referred person pays for the
// MONTHLY plan specifically (not the 5-day trial). As soon as one referral
// qualifies, the referrer immediately gets one free month — see
// subscriptionController.checkReferralReward. No cash reward — removed per
// product decision; a free month is the only referral benefit.
model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String   @unique
  referred      User     @relation("ReferredUser", fields: [referredId], references: [id], onDelete: Cascade)
  qualified     Boolean  @default(false)
  rewardGranted Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@map("referrals")
}

model Flashcard {
  id         String   @id @default(cuid())
  subject    String // Physics | Chemistry | Biology
  classLevel String // "6th".."12th" | "Dropper"
  chapter    String
  front      String   @db.Text
  back       String   @db.Text
  createdAt  DateTime @default(now())
  @@map("flashcards")
}

model Formula {
  id         String   @id @default(cuid())
  subject    String // Physics | Chemistry
  classLevel String
  chapter    String
  title      String
  expression String   @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  @@map("formulas")
}
model XP {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  total  Int    @default(0)
  level  Int    @default(1)
  @@map("xp")
}
model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  condition   String
  userBadges  UserBadge[]
  @@map("badges")
}
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())
  @@unique([userId, badgeId])
  @@map("user_badges")
}

// YNeet Shorts — 3–5 minute concept videos made by a small set of paid
// creators (Seekho-style "showrunner" model). The video itself lives on an
// external host (YouTube / Bunny Stream / a direct MP4 URL); we only store
// which host and the id/URL needed to embed it. After watching, the student
// gets the linked MCQs from the existing question bank as a quick check.
model Short {
  id           String      @id @default(cuid())
  title        String
  description  String?     @db.Text
  subject      String      // Physics | Chemistry | Biology
  // "6th".."12th" | "Dropper" | "All". See shortsController.visibleClassLevels
  // for which classes see which Shorts (e.g. 12th also sees 11th revision).
  classLevel   String      @default("12th")
  chapter      String
  language     String      @default("English") // English | Tamil | Hindi | ...
  // youtube | bunny | mp4 — parsed from the link the admin pastes
  provider     String
  // youtube: the 11-char video id; bunny: "<libraryId>/<videoId>"; mp4: full URL
  videoRef     String
  durationSec  Int?
  // Credit shown on screen. For creator-submitted Shorts this is copied from
  // the Creator's name; admin-added Shorts can use any name.
  creatorName  String      @default("YNeet")
  creatorId    String?
  creator      Creator?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  // Creator submissions start "pending" and only go live once an admin approves
  // them. Shorts the admin adds directly are "approved" straight away.
  reviewStatus String      @default("approved") // pending | approved | rejected
  reviewNote   String?     @db.Text
  submittedAt  DateTime    @default(now())
  approvedAt   DateTime?
  // Rupees owed to the creator for this Short, fixed at approval from their rate.
  payAmount    Int         @default(0)
  payoutId     String?
  payout       CreatorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  // Featured Shorts are public: shown on the yneet.in landing page and playable
  // on their share page (/s/:id) without logging in.
  isFeatured   Boolean     @default(false)
  isPublished  Boolean     @default(true)
  // Denormalised counter for the admin creator report (first watch per student).
  viewCount    Int         @default(0)
  questions    Question[]
  views        ShortView[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([isPublished, subject, classLevel])
  @@index([creatorId, reviewStatus])
  @@map("shorts")
}

// One row per student per Short: first watch + quick-check results.
model ShortView {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortId     String
  short       Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  quizCorrect Int      @default(0)
  quizTotal   Int      @default(0)
  // Question ids already answered here, so re-answering doesn't inflate the score.
  answeredIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([userId, shortId])
  @@map("short_views")
}

// A teacher who makes YNeet Shorts. Applies on /creator/apply, logs in with
// email + password (separate from student SSO), and is approved by an admin
// before they can submit. Paid per approved Short, settled weekly.
model Creator {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String
  passwordHash String
  bio          String?         @db.Text
  youtubeUrl   String?
  instagramUrl String?
  subjects     String[]
  languages    String[]
  upiId        String?
  // Rupees paid per approved Short. Set by the admin; copied onto each Short
  // when it's approved so later rate changes don't alter past earnings.
  ratePerVideo Int             @default(500)
  status       String          @default("pending") // pending | approved | suspended
  // Email check + password reset by a 6-digit code (stored hashed, 15 min, 5 tries).
  // Creators who joined before email verification existed count as verified.
  emailVerifiedAt DateTime?
  codeHash        String?
  codePurpose     String?   // verify | reset
  codeExpires     DateTime?
  codeTries       Int       @default(0)
  shorts       Short[]
  payouts      CreatorPayout[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@map("creators")
}

// One weekly settlement: every approved, not-yet-paid Short of a creator up to
// periodEnd. Created automatically each Monday (or by the admin); the admin
// marks it paid after sending the money.
model CreatorPayout {
  id          String    @id @default(cuid())
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  videoCount  Int
  amount      Int       // rupees for the Shorts
  bonus       Int       @default(0) // optional extra, e.g. for a top-performing Short
  status      String    @default("pending") // pending | paid
  paidAt      DateTime?
  reference   String?   // UPI/bank reference entered when paid
  shorts      Short[]
  createdAt   DateTime  @default(now())
  @@index([creatorId, status])
  @@map("creator_payouts")
}
