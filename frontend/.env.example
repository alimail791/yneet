# Raise Academy's frontend origin — used to bounce students back there when
# there's no valid YNeet session (no local login page exists anymore).
VITE_RAISE_ACADEMY_URL=http://localhost:5173

# Absolute URL of the YNeet backend's API, including /api/v1.
# Leave unset for local dev (uses Vite's proxy). REQUIRED in production —
# e.g. https://appapi.yneet.in/api/v1
VITE_API_URL=
