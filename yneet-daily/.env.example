# Postgres (on Railway: add a Postgres service and reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:pass@host:5432/railway
# PGSSL=1               # set if your Postgres needs SSL from outside Railway

# Long random string. Changing it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin endpoints: /api/admin/stats and /api/admin/players.csv (send header x-admin-key or ?key=)
ADMIN_KEY=change-me

# WhatsApp Cloud API (same Meta app and number as the Raise Academy bot)
WA_TOKEN=
WA_PHONE_ID=
WA_OTP_TEMPLATE=yneet_otp          # approved AUTHENTICATION template with copy-code button
WA_REWARD_TEMPLATE=                # optional UTILITY template: {{1}} = first name, {{2}} = reward code
WA_TEMPLATE_LANG=en
# WA_API_VERSION=v21.0

# Testing only: fixed OTP used when WhatsApp is not configured. Never set this in production.
# DEV_OTP=1234

# Referral reward
REFERRALS_NEEDED=3
# Codes you put in your own links that are not players, e.g. yneet.in/play?r=STATUS
HOUSE_CODES=STATUS,AKBAR
# Optional: POSTed when someone unlocks the free month, so YNeet can extend their plan automatically
# YNEET_REWARD_WEBHOOK=https://appapi.yneet.in/hooks/referral-reward
# YNEET_WEBHOOK_SECRET=

# If the page is served from another domain (e.g. www.yneet.in) and calls this API
# CORS_ORIGINS=https://www.yneet.in

# Limits
# OTP_RESEND_SECONDS=45
# OTP_PER_IP_HOUR=60

# Testing only: pretend today is this date
# PUZZLE_DATE=2026-10-24
